{
  "manifest_version": 3,
  "name": "Remotype",
  "version": "1.3.0",
  "description": "Type it where paste can't: types text key by key into vSphere, noVNC and Proxmox web consoles.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "storage", "sidePanel", "alarms"],
  "action": {
    "default_title": "Remotype",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open Remotype popup"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open Remotype side panel"
    }
  }
}
